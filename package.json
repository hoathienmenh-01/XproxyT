{
  "name": "qwen-provider",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib dist",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "dev": "bun ./src/dev.ts",
    "dev:server": "bun ./src/dev.ts",
