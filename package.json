    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@koa/router": "^10.1.1",
    "axios": "^1.16.1",
    "eventsource-parser": "^3.0.6",
    "koa": "^2.14.2",
    "koa-bodyparser": "^4.3.0",
    "koa-static": "^5.0.0",
    "puppeteer": "^24.43.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.0",
    "zstd-codec": "^0.1.5"
  },
  "devDependencies": {
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-router": "^7.4.9",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.19.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6",
    "vite": "^5.4.21"
